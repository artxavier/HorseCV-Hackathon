# Imagem do servidor de inferencia -- usada no modo CLOUD (e opcionalmente no FOG).
# O mesmo codigo e o mesmo contrato HTTP do edge; so muda onde roda.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MODELS_DIR=/app/models \
    DETECTOR=rfdetr \
    DEVICE=cpu \
    DEVICE_LABEL=cloud-cpu

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# torch CPU-only: a imagem cai de ~6 GB para ~1.5 GB
COPY requirements.txt .
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements.txt

COPY common/ ./common/
COPY inference/ ./inference/
COPY scripts/download_models.sh ./scripts/

# pesos assados na imagem: o primeiro request nao paga download
RUN PYTHON=python bash scripts/download_models.sh || true

EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s \
    CMD curl -fsS http://localhost:8001/health || exit 1

CMD ["sh", "-c", "uvicorn inference.server:app --host 0.0.0.0 --port ${PORT:-8001}"]
